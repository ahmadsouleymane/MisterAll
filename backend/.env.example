# Server Configuration
PORT=7070
NODE_ENV=production

# MongoDB Connection
# Generate strong password, add connection pooling options
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/misterall?retryWrites=true&w=majority&maxPoolSize=10&minPoolSize=5

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
KEY=your-64-character-random-secret-here

# AI APIs
GROQ_KEY=your-groq-api-key
GROQ_PATH=https://api.groq.com/openai/v1/chat/completions
HUGGINGFACEHUB_API_KEY=your-huggingface-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# AI Model Configuration
USE_DEEPSEEK_R1=true
MIN_QUALITY_SCORE=60

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key

# Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:contact@misterall.tech

# Optional: Logging
LOG_LEVEL=info
